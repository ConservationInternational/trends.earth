    "UNBL:layers": [
        {
            "id": "ed054a35-6d94-41a4-89cb-e0fcb97fc7af",
            "name": "World Terrestrial Ecosystems"
        }
    ],
    "description": "The new map of terrestrial World Ecosystems was derived from the objective development and integration of 1) global temperature domains, 2) global moisture domains, 3) global landforms, and 4) 2015 global vegetation and land use. A total of 431 World Ecosystems were identified, and of these a total of 278 units were natural or semi-natural vegetation/environment combinations, including different kinds of forestlands, shrublands, grasslands, bare areas, and ice/snow regions.",
    "preview:bbox": [
        -180,
        -85.0511,
        180,
        85.0511
    ],
    "sci:citation": "Sayre, R., Karagulle, D., Frye, C., Boucher, T., Wolff, N.H., Breyer, S., Wright, D., Martin, M., Butler, K., Van Graafeiland, K., Touval, J., Sotomayor, L., McGowan, J., Game, E.T., Possingham, H., 2020. An assessment of the representation of ecosystems in global protected areas using new maps of World Climate Regions and World Ecosystems. Global Ecology and Conservation 21, e00860. https://doi.org/10.1016/j.gecco.2019.e00860",
    "stac_version": "1.0.0",
    "stac_extensions": []
