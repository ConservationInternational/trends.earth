        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The polygons have only a Name, their Site_ID, and their attributes are in an XLSX of the same name, e.g. IND_V20261231.kml and IND_V20261231.xlsx, e.g. for Google Earth. Keep both files in the same folder.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="text">
        <string>Attributes in a separate XLSX</string>
       </property>
